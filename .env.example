# ---- ReSync server (packages/server) ----
# Copy to .env and fill in. Never commit .env.
PORT=8787
# MongoDB connection string (local docker-compose uses mongodb://mongo:27017/resync)
MONGODB_URI=mongodb://localhost:27017/resync
# Public URL of the server, used to build OAuth callback URLs (no trailing slash)
PUBLIC_SERVER_URL=http://localhost:8787
# Public URL of the dashboard (used for redirects and CORS)
DASHBOARD_URL=http://localhost:5173
# Extra CORS origins, comma separated (e.g. chrome-extension://<your-extension-id>)
CORS_ORIGINS=
# Long random string used to sign session cookies. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me
# GitHub OAuth app (https://github.com/settings/developers). Callback: ${PUBLIC_SERVER_URL}/api/v1/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Google OAuth client (https://console.cloud.google.com/apis/credentials). Callback: ${PUBLIC_SERVER_URL}/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Development-only password-less login (NEVER enable in production; the server refuses to start with it)
ALLOW_DEV_LOGIN=false
LOG_LEVEL=info
# production | development. Production enforces a strong SESSION_SECRET and Secure cookies.
NODE_ENV=production
# Behind a reverse proxy (Render, nginx, Caddy): trust one X-Forwarded-* hop.
TRUST_PROXY=false
# Folder of a built dashboard for the server to serve on the same origin (set automatically in the Docker image).
SERVE_DASHBOARD=

# ---- docker-compose only ----
# Interface to publish on: 127.0.0.1 (local only, default) or 0.0.0.0 (behind your HTTPS proxy).
RESYNC_BIND=127.0.0.1
RESYNC_PORT=8787

# ---- Dashboard (packages/dashboard, build time) ----
# Server URL the dashboard talks to. Leave blank to use the same origin (docker-compose proxies /api).
VITE_RESYNC_SERVER_URL=
