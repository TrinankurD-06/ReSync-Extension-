{
  "manifest_version": 3,
  "name": "ReSync",
  "version": "0.1.0",
  "description": "Prompt library, multi-step chains, Context Passport, topic tree, summaries and usage estimates for claude.ai. Not affiliated with Anthropic.",
  "minimum_chrome_version": "116",
  "action": { "default_title": "Open ReSync" },
  "side_panel": { "default_path": "sidepanel.html" },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["sidePanel", "storage", "alarms"],
  "host_permissions": ["https://claude.ai/*"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "content_scripts": [
    { "matches": ["https://claude.ai/*"], "js": ["nav-hook.js"], "run_at": "document_start", "world": "MAIN" },
    { "matches": ["https://claude.ai/*"], "js": ["content.js"], "run_at": "document_idle" }
  ],
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
}
